@page "/dashboard"
@inject JobApiService JobService
@inject AuthService AuthService
@using StudentJobHub.Client
@using StudentJobHub.Client.Layout
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services

<PageTitle>Dashboard - Student Job Hub</PageTitle>

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>

            @if (AuthService.IsLoggedIn)
            {
                <p>Welcome back to Student Job Hub.</p>
            }
            else
            {
                <p>Welcome to Student Job Hub.</p>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <p>Loading dashboard...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="error-message">
            <p>@errorMessage</p>
        </div>
    }
    else
    {
        <!-- Statistics -->

        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-icon">💼</div>

                <div>
                    <h3>@jobs.Count</h3>
                    <p>Available Jobs</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">📋</div>

                <div>
                    <h3>0</h3>
                    <p>My Applications</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">⭐</div>

                <div>
                    <h3>0</h3>
                    <p>My Services</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">🔔</div>

                <div>
                    <h3>0</h3>
                    <p>Notifications</p>
                </div>
            </div>

        </div>

        <!-- Quick Actions -->

        <section class="dashboard-section">

            <div class="section-header">
                <h2>Quick Actions</h2>
            </div>

            <div class="actions-grid">

                <a href="/jobs" class="action-card">
                    <span class="action-icon">🔎</span>

                    <div>
                        <h3>Browse Jobs</h3>
                        <p>Find available jobs on campus.</p>
                    </div>
                </a>

                <a href="/my-applications" class="action-card">
                    <span class="action-icon">📋</span>

                    <div>
                        <h3>My Applications</h3>
                        <p>Track jobs you have applied for.</p>
                    </div>
                </a>

                <a href="/my-jobs" class="action-card">
                    <span class="action-icon">💼</span>

                    <div>
                        <h3>My Jobs</h3>
                        <p>Manage jobs you have posted.</p>
                    </div>
                </a>

                <a href="/profile" class="action-card">
                    <span class="action-icon">👤</span>

                    <div>
                        <h3>My Profile</h3>
                        <p>View and manage your profile.</p>
                    </div>
                </a>

            </div>

        </section>

        <!-- Recent Jobs -->

        <section class="dashboard-section">

            <div class="section-header">
                <h2>Recent Jobs</h2>

                <a href="/jobs">View All</a>
            </div>

            @if (jobs.Count == 0)
            {
                <div class="empty-state">
                    <h3>No jobs available</h3>
                    <p>There are currently no jobs posted.</p>
                </div>
            }
            else
            {
                <div class="jobs-grid">

                    @foreach (var job in jobs.Take(5))
                    {
                        <div class="job-card">

                            <div class="job-card-header">
                                <h3>@job.Title</h3>

                                @if (job.IsOpen)
                                {
                                    <span class="status open">
                                        Open
                                    </span>
                                }
                                else
                                {
                                    <span class="status closed">
                                        Closed
                                    </span>
                                }
                            </div>

                            <p class="job-description">
                                @job.Description
                            </p>

                            <div class="job-info">
                                <span>
                                    💰 GH₵ @job.Budget.ToString("N2")
                                </span>

                                <span>
                                    📅 @job.Deadline.ToString("MMM dd, yyyy")
                                </span>
                            </div>

                            <div class="job-footer">
                                <span>
                                    Posted by @job.PostedByName
                                </span>

                                <a href="/jobs/@job.Id">
                                    View Details →
                                </a>
                            </div>

                        </div>
                    }

                </div>
            }

        </section>

    }

</div>

<style>

    .dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        margin-bottom: 5px;
        font-size: 32px;
    }

    .dashboard-header p {
        color: #6b7280;
        margin: 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 35px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 22px;
        border-radius: 12px;
        background: white;
        border: 1px solid #e5e7eb;
    }

    .stat-icon {
        font-size: 30px;
    }

    .stat-card h3 {
        margin: 0;
        font-size: 25px;
    }

    .stat-card p {
        margin: 4px 0 0;
        color: #6b7280;
    }

    .dashboard-section {
        margin-bottom: 40px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .section-header h2 {
        margin: 0;
    }

    .section-header a {
        text-decoration: none;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .action-card {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: white;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
    }

    .action-card h3 {
        margin: 0 0 5px;
    }

    .action-card p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .action-icon {
        font-size: 25px;
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .job-card {
        padding: 22px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: white;
    }

    .job-card-header {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .job-card-header h3 {
        margin: 0;
    }

    .status {
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 12px;
        height: fit-content;
    }

    .status.open {
        background: #dcfce7;
        color: #166534;
    }

    .status.closed {
        background: #fee2e2;
        color: #991b1b;
    }

    .job-description {
        margin: 15px 0;
        color: #6b7280;
        line-height: 1.5;
    }

    .job-info {
        display: flex;
        gap: 20px;
        font-size: 14px;
        margin-bottom: 18px;
    }

    .job-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 15px;
        border-top: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .job-footer a {
        text-decoration: none;
        font-weight: 600;
    }

    .empty-state,
    .loading,
    .error-message {
        padding: 30px;
        text-align: center;
        border-radius: 12px;
        background: #f9fafb;
    }

    .error-message {
        color: #991b1b;
        background: #fee2e2;
    }

    @@media (max-width: 900px) {
        .stats-grid,
        .actions-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .jobs-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .stats-grid,
        .actions-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

@code {

    private List<JobModel> jobs = new();

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            jobs = await JobService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load dashboard data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}