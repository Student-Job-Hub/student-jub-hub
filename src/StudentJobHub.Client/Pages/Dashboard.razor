@page "/dashboard"
@inject JobApiService JobService
@inject AuthService AuthService
@inject ApplicationApiService ApplicationService
@inject ServiceApiService ServiceApiService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@using StudentJobHub.Client
@using StudentJobHub.Client.Layout
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services

<PageTitle>Dashboard - Student Job Hub</PageTitle>

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>

            @if (AuthService.IsLoggedIn)
            {
                <p>Welcome back to Student Job Hub.</p>
            }
            else
            {
                <p>Welcome to Student Job Hub. Log in to access your personal dashboard.</p>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <p>Loading dashboard...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="error-message">
            <p>@errorMessage</p>
            @if (isUnauthorized)
            {
                <a href="/login?returnUrl=/dashboard" class="action-btn">Log In Again</a>
            }
            else
            {
                <button class="action-btn" @onclick="LoadDashboardAsync">Try Again</button>
            }
        </div>
    }
    else
    {
        <!-- Statistics -->

        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-icon">💼</div>

                <div>
                    <h3>@jobs.Count</h3>
                    <p>Available Jobs</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">📋</div>

                <div>
                    <h3>@applicationCount</h3>
                    <p>My Applications</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">🛠️</div>

                <div>
                    <h3>@myServiceCount</h3>
                    <p>My Offered Services</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">⭐</div>

                <div>
                    <h3>@serviceCount</h3>
                    <p>Available Services</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">🔔</div>

                <div>
                    <h3>@unreadNotificationCount</h3>
                    <p>Notifications</p>
                </div>
            </div>

        </div>

        <!-- Quick Actions -->

        <section class="dashboard-section">

            <div class="section-header">
                <h2>Quick Actions</h2>
            </div>

            <div class="actions-grid">

                <a href="/jobs" class="action-card">
                    <span class="action-icon">🔎</span>

                    <div>
                        <h3>Browse Jobs</h3>
                        <p>Find available jobs on campus.</p>
                    </div>
                </a>

                <a href="/post-job" class="action-card">
                    <span class="action-icon">➕</span>

                    <div>
                        <h3>Post a Job</h3>
                        <p>Create a new job opportunity.</p>
                    </div>
                </a>

                <a href="/my-applications" class="action-card">
                    <span class="action-icon">📋</span>

                    <div>
                        <h3>My Applications</h3>
                        <p>Track jobs you have applied for.</p>
                    </div>
                </a>

                <a href="/my-jobs" class="action-card">
                    <span class="action-icon">💼</span>

                    <div>
                        <h3>My Jobs</h3>
                        <p>Manage jobs you have posted.</p>
                    </div>
                </a>

                <a href="/services" class="action-card">
                    <span class="action-icon">🛠️</span>

                    <div>
                        <h3>Services</h3>
                        <p>Browse campus freelance services.</p>
                    </div>
                </a>

                <a href="/profile" class="action-card">
                    <span class="action-icon">👤</span>

                    <div>
                        <h3>My Profile</h3>
                        <p>View and manage your profile.</p>
                    </div>
                </a>

            </div>

        </section>

        <!-- Application Breakdown -->
        <section class="dashboard-section">
            <div class="section-header">
                <h2>Application Status Overview</h2>
                <a href="/my-applications">View Details</a>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem;">
                <div style="background: #fffbebf5; border: 1px solid #fef3c7; border-radius: 10px; padding: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <span style="font-size: 0.85rem; color: #92400e; font-weight: 600; text-transform: uppercase;">Pending</span>
                        <h3 style="margin: 0.25rem 0 0; font-size: 1.75rem; color: #78350f;">@pendingApplicationCount</h3>
                    </div>
                    <span style="font-size: 2rem;">⏳</span>
                </div>

                <div style="background: #f0fdf4; border: 1px solid #dcfce7; border-radius: 10px; padding: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <span style="font-size: 0.85rem; color: #166534; font-weight: 600; text-transform: uppercase;">Accepted</span>
                        <h3 style="margin: 0.25rem 0 0; font-size: 1.75rem; color: #14532d;">@acceptedApplicationCount</h3>
                    </div>
                    <span style="font-size: 2rem;">🎉</span>
                </div>

                <div style="background: #fef2f2; border: 1px solid #fee2e2; border-radius: 10px; padding: 1.25rem; display: flex; align-items: center; justify-content: space-between;">
                    <div>
                        <span style="font-size: 0.85rem; color: #991b1b; font-weight: 600; text-transform: uppercase;">Rejected</span>
                        <h3 style="margin: 0.25rem 0 0; font-size: 1.75rem; color: #7f1d1d;">@rejectedApplicationCount</h3>
                    </div>
                    <span style="font-size: 2rem;">❌</span>
                </div>
            </div>
        </section>

        <!-- Recent Jobs -->

        <section class="dashboard-section">

            <div class="section-header">
                <h2>Recent Jobs</h2>

                <a href="/jobs">View All</a>
            </div>

            @if (jobs.Count == 0)
            {
                <div class="empty-state">
                    <h3>No jobs available</h3>
                    <p>There are currently no jobs posted.</p>
                </div>
            }
            else
            {
                <div class="jobs-grid">

                    @foreach (var job in jobs.Take(6))
                    {
                        <div class="job-card">

                            <div class="job-card-header">
                                <h3>@job.Title</h3>

                                @if (job.IsOpen)
                                {
                                    <span class="status open">
                                        Open
                                    </span>
                                }
                                else
                                {
                                    <span class="status closed">
                                        Closed
                                    </span>
                                }
                            </div>

                            <p class="job-description">
                                @job.Description
                            </p>

                            <div class="job-info">
                                <span>
                                    💰 GH₵ @job.Budget.ToString("N2")
                                </span>

                                <span>
                                    📅 @job.Deadline.ToString("MMM dd, yyyy")
                                </span>
                            </div>

                            <div class="job-footer">
                                <span>
                                    Posted by @job.PostedByName
                                </span>

                                <a href="/jobs/@job.Id">
                                    View Details →
                                </a>
                            </div>

                        </div>
                    }

                </div>
            }

        </section>

    }

</div>

<style>

    .dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        margin-bottom: 5px;
        font-size: 32px;
    }

    .dashboard-header p {
        color: #6b7280;
        margin: 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 35px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 22px;
        border-radius: 12px;
        background: white;
        border: 1px solid #e5e7eb;
    }

    .stat-icon {
        font-size: 30px;
    }

    .stat-card h3 {
        margin: 0;
        font-size: 25px;
    }

    .stat-card p {
        margin: 4px 0 0;
        color: #6b7280;
    }

    .dashboard-section {
        margin-bottom: 40px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .section-header h2 {
        margin: 0;
    }

    .section-header a {
        text-decoration: none;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .action-card {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: white;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .action-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
    }

    .action-card h3 {
        margin: 0 0 5px;
    }

    .action-card p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .action-icon {
        font-size: 25px;
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .job-card {
        padding: 22px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: white;
    }

    .job-card-header {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .job-card-header h3 {
        margin: 0;
    }

    .status {
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 12px;
        height: fit-content;
    }

    .status.open {
        background: #dcfce7;
        color: #166534;
    }

    .status.closed {
        background: #fee2e2;
        color: #991b1b;
    }

    .job-description {
        margin: 15px 0;
        color: #6b7280;
        line-height: 1.5;
    }

    .job-info {
        display: flex;
        gap: 20px;
        font-size: 14px;
        margin-bottom: 18px;
    }

    .job-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 15px;
        border-top: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .job-footer a {
        text-decoration: none;
        font-weight: 600;
    }

    .empty-state,
    .loading,
    .error-message {
        padding: 30px;
        text-align: center;
        border-radius: 12px;
        background: #f9fafb;
    }

    .error-message {
        color: #991b1b;
        background: #fee2e2;
    }

    .action-btn {
        display: inline-block;
        margin-top: 12px;
        padding: 10px 18px;
        background: #2563eb;
        color: white;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        font-weight: 600;
        cursor: pointer;
    }

    @@media (max-width: 900px) {
        .stats-grid,
        .actions-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .jobs-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .stats-grid,
        .actions-grid {
            grid-template-columns: 1fr;
        }
    }

</style>

@code {

    private List<JobModel> jobs = new();
    private int applicationCount;
    private int pendingApplicationCount;
    private int acceptedApplicationCount;
    private int rejectedApplicationCount;
    private int serviceCount;
    private int myServiceCount;
    private int unreadNotificationCount;

    private bool isLoading = true;
    private bool isUnauthorized = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;
        isUnauthorized = false;

        try
        {
            await AuthService.GetTokenAsync();

            jobs = await JobService.GetAllAsync();

            try
            {
                var services = await ServiceApiService.GetAllAsync();
                serviceCount = services.Count;
            }
            catch
            {
                serviceCount = 0;
            }

            if (AuthService.IsLoggedIn)
            {
                try
                {
                    var myServices = await ServiceApiService.GetMyServicesAsync();
                    myServiceCount = myServices.Count;
                }
                catch
                {
                    myServiceCount = 0;
                }

                try
                {
                    var myApplications = await ApplicationService.GetMyApplicationsAsync();
                    applicationCount = myApplications.Count;
                    pendingApplicationCount = myApplications.Count(a => string.Equals(a.Status, "Pending", StringComparison.OrdinalIgnoreCase));
                    acceptedApplicationCount = myApplications.Count(a => string.Equals(a.Status, "Accepted", StringComparison.OrdinalIgnoreCase));
                    rejectedApplicationCount = myApplications.Count(a => string.Equals(a.Status, "Rejected", StringComparison.OrdinalIgnoreCase));
                }
                catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    isUnauthorized = true;
                }

                try
                {
                    var notifications = await NotificationService.GetNotificationsAsync();
                    unreadNotificationCount = notifications.Count(n => !n.IsRead);
                }
                catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    isUnauthorized = true;
                }

                if (isUnauthorized)
                {
                    errorMessage = "Your session has expired. Please log in again to view your dashboard.";
                    return;
                }
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            isUnauthorized = true;
            errorMessage = "Your session has expired. Please log in again to access the dashboard.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load dashboard data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}