@page "/login"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login - Student Job Hub</PageTitle>

<div class="auth-page">
    <div class="auth-card">

        <h1>Welcome Back</h1>
        <p class="auth-subtitle">
            Sign in to your Student Job Hub account.
        </p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Email</label>

                <InputText
                    class="form-control"
                    @bind-Value="loginModel.Email"
                    type="email" />

                <ValidationMessage
                    For="@(() => loginModel.Email)" />
            </div>

            <div class="form-group">
                <label>Password</label>

                <InputText
                    class="form-control"
                    @bind-Value="loginModel.Password"
                    type="password" />

                <ValidationMessage
                    For="@(() => loginModel.Password)" />
            </div>

            <button
                type="submit"
                class="btn btn-primary w-100"
                disabled="@isLoading">

                @(isLoading ? "Logging in..." : "Login")
            </button>
        </EditForm>

        <div class="auth-footer">
            <span>Don't have an account?</span>

            <a href="/register">
                Create one
            </a>
        </div>

    </div>
</div>

@code {
    private LoginModel loginModel = new();

    private bool isLoading;
    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (result == null)
            {
                errorMessage = "Invalid email or password.";
                return;
            }

            if (string.IsNullOrWhiteSpace(result.Token))
            {
                errorMessage = "Login succeeded, but no authentication token was returned.";
                return;
            }

            // We will add persistent token storage next.
            // For now, redirect after successful login.
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}