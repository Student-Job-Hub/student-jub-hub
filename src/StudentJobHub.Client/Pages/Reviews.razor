@page "/reviews"
@page "/reviews/{UserId}"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ReviewApiService ReviewApiService
@inject AuthService AuthService

<PageTitle>Reviews | Student Job Hub</PageTitle>

<div class="page-container">
	<h1>Reviews</h1>
	@if (string.IsNullOrWhiteSpace(UserId))
	{
		<div class="empty-state">
			<p>Open a user's review link to view their reviews.</p>
		</div>
	}
	else if (isLoading)
	{
		<div class="loading-state">Loading reviews...</div>
	}
	else if (!string.IsNullOrEmpty(errorMessage))
	{
		<div class="error-state"><p>@errorMessage</p></div>
	}
	else if (reviews.Count == 0)
	{
		<div class="empty-state"><p>No reviews have been posted yet.</p></div>
	}
	else
	{
		<div class="reviews-list">

	@if (!string.IsNullOrWhiteSpace(UserId) && AuthService.IsLoggedIn)
	{
		<section class="review-form">
			<h2>Leave a Review</h2>
			<EditForm Model="@newReview" OnValidSubmit="CreateReviewAsync">
				<DataAnnotationsValidator />
				<div class="form-group">
					<label for="rating">Rating</label>
					<InputNumber id="rating" class="form-control" @bind-Value="newReview.Rating" />
					<ValidationMessage For="@(() => newReview.Rating)" />
				</div>
				<div class="form-group">
					<label for="comment">Comment</label>
					<InputTextArea id="comment" class="form-control" @bind-Value="newReview.Comment" rows="4" />
				</div>
				@if (!string.IsNullOrEmpty(createError))
				{
					<p class="error-state">@createError</p>
				}
				<button type="submit" class="primary-button" disabled="@isCreating">
					@(isCreating ? "Submitting..." : "Submit Review")
				</button>
			</EditForm>
		</section>
	}
			@foreach (var review in reviews)
			{
				<article class="review-card">
					<h2>@review.Rating / 5</h2>
					<p>@review.Comment</p>
					<small>By @review.ReviewerName on @review.CreatedAt.ToString("dd MMM yyyy")</small>
				</article>
			}
		</div>
	}
</div>

@code {
	[Parameter] public string? UserId { get; set; }

	private List<ReviewModel> reviews = new();
	private CreateReviewModel newReview = new();
	private bool isLoading;
	private bool isCreating;
	private string? errorMessage;
	private string? createError;

	protected override async Task OnParametersSetAsync()
	{
		if (string.IsNullOrWhiteSpace(UserId))
		{
			return;
		}

		isLoading = true;
		errorMessage = null;
		try
		{
			reviews = await ReviewApiService.GetUserReviewsAsync(UserId);
		}
		catch (Exception ex)
		{
			errorMessage = $"Unable to load reviews: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task CreateReviewAsync()
	{
		if (newReview.Rating is < 1 or > 5)
		{
			createError = "Rating must be between 1 and 5.";
			return;
		}

		isCreating = true;
		createError = null;
		newReview.RevieweeId = UserId!;

		try
		{
			var response = await ReviewApiService.CreateAsync(newReview);
			if (response.IsSuccessStatusCode)
			{
				newReview = new CreateReviewModel();
				await OnParametersSetAsync();
			}
			else
			{
				createError = await response.Content.ReadAsStringAsync();
			}
		}
		catch (Exception ex)
		{
			createError = $"Unable to submit review: {ex.Message}";
		}
		finally
		{
			isCreating = false;
		}
	}
}
