@page "/not-found"
@layout MainLayout
    

<section class="not-found-section">
    <div class="not-found-container">
        <div class="not-found-header">
            <h1>404</h1>
            <p>Page Not Found</p>
        </div>
        <div class="not-found-content">
            <p>We're sorry, but the page you're looking for doesn't exist or has been moved.</p>
            <a href="/" class="not-found-button">Go to Homepage</a>
        </div>
    </div>
</section>


<style>
    .not-found-section {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #f8fafc;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }

    .not-found-container {
        text-align: center;
        max-width: 600px;
        padding: 40px;
    }

    .not-found-header h1 {
        font-size: 96px;
        font-weight: 900;
        color: #e11d48;
        margin: 0;
        letter-spacing: -2px;
    }

    .not-found-header p {
        font-size: 24px;
        font-weight: 600;
        color: #475569;
        margin-top: 8px;
    }

    .not-found-content p {
        font-size: 16px;
        color: #64748b;
        margin-top: 24px;
    }

    .not-found-button {
        display: inline-block;
        margin-top: 32px;
        padding: 12px 32px;
        background: #e11d48;
        color: #ffffff;
        text-decoration: none;
        border-radius: 999px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .not-found-button:hover {
        background: #be123c;
        transform: translateY(-2px);
    }
</style>