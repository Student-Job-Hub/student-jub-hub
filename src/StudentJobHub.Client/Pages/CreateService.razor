@page "/create-service"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ServiceApiService ServiceApiService
@inject NavigationManager Navigation

<PageTitle>Create Service | Student Job Hub</PageTitle>

<div class="page-container">
    <h1>Post a Service</h1>
    <EditForm Model="@model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">@errorMessage</div>
        }

        <div class="form-group">
            <label>Title</label>
            <InputText class="form-control" @bind-Value="model.Title" />
            <ValidationMessage For="@(() => model.Title)" />
        </div>

        <div class="form-group">
            <label>Category</label>
            <InputSelect class="form-control" @bind-Value="model.Category">
                <option value="">Select Category</option>
                <option value="Freelance">Freelance</option>
                <option value="Tutoring">Tutoring</option>
                <option value="Academic Help">Academic Help</option>
                <option value="Creative Services">Creative Services</option>
                <option value="Technical Services">Technical Services</option>
                <option value="Event Services">Event Services</option>
                <option value="Other">Other</option>
            </InputSelect>
            <ValidationMessage For="@(() => model.Category)" />
        </div>

        <div class="form-group">
            <label>Description</label>
            <InputTextArea class="form-control" @bind-Value="model.Description" />
            <ValidationMessage For="@(() => model.Description)" />
        </div>

        <div class="form-group">
            <label>Price (GH₵)</label>
            <InputNumber class="form-control" @bind-Value="model.Price" />
            <ValidationMessage For="@(() => model.Price)" />
        </div>

        <button type="submit" class="secondary-button" disabled="@isSubmitting">
            @(isSubmitting ? "Posting..." : "Post Service")
        </button>
    </EditForm>
</div>

<style>
   .error-message {
              color: #dc3545;
              margin: 15px 0;
              padding: 10px 15px;
              background-color: #ffe9ea;
              border: 1px solid #f5c6cb;
              border-radius: 5px;
              font-weight: 500;
   }
</style>

@code {
    private CreateServiceModel model = new();
    private bool isSubmitting;
    private string? errorMessage;

    private async Task HandleSubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await ServiceApiService.CreateAsync(model);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/services");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You must be logged in to post a service.";
            }
            else
                errorMessage = "Unable to create the service.";
            
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to create the service: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
