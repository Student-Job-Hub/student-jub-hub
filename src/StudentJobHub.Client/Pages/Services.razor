@page "/services"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ServiceApiService ServiceApiService
@inject UserApiService UserApiService
@inject AuthService AuthService

<PageTitle>Services | Student Job Hub</PageTitle>

<div class="services-page">
    <div class="page-header">
        <div>
            <h1>Services Marketplace</h1>
            <p>Find campus services and skills posted by members.</p>
        </div>
        <a href="/create-service" class="primary-button">Post a Service</a>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">Loading services...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <h2>Unable to load services</h2>
            <p>@errorMessage</p>
            <button @onclick="LoadServicesAsync">Try Again</button>
        </div>
    }
    else if (services.Count == 0)
    {
        <div class="empty-state">
            <h2>No services available</h2>
            <p>There are no services posted yet.</p>
        </div>
    }
    else
    {
        <div class="services-grid">
            @foreach (var service in services)
            {
                <div class="service-card">
                    <div class="service-header">
                        <h2>@service.Title</h2>
                        <span class="badge">@service.Category</span>
                    </div>
                    <p>@service.Description</p>
                    <div class="meta">
                        <strong>GH₵ @service.Price.ToString("N2")</strong>
                        <span>By @service.ProviderName</span>
                    </div>
                    <div class="actions">
                        <a href="/services/@service.Id" class="secondary-button">View Details</a>
                        @if (IsOwner(service))
                        {
                            <a href="/services/edit/@service.Id" class="secondary-button">Edit</a>
                            <button class="danger-button"
                                    @onclick="() => DeleteServiceAsync(service.Id)"
                                    disabled="@IsDeleting(service.Id)">
                                @(IsDeleting(service.Id) ? "Deleting..." : "Delete")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServiceModel> services = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? currentUserId;
    private int? deletingServiceId;

    protected override async Task OnInitializedAsync()
    {
        await LoadServicesAsync();
    }

    private async Task LoadServicesAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            services = await ServiceApiService.GetAllAsync();

            if (AuthService.IsLoggedIn)
            {
                var currentUser = await UserApiService.GetCurrentUserAsync();
                currentUserId = currentUser?.Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load services: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsOwner(ServiceModel service) =>
        !string.IsNullOrWhiteSpace(currentUserId) &&
        service.ProviderId == currentUserId;

    private bool IsDeleting(int serviceId) => deletingServiceId == serviceId;

    private async Task DeleteServiceAsync(int serviceId)
    {
        deletingServiceId = serviceId;
        errorMessage = null;

        try
        {
            var response = await ServiceApiService.DeleteAsync(serviceId);
            if (response.IsSuccessStatusCode)
            {
                services.RemoveAll(service => service.Id == serviceId);
            }
            else
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "You must be logged in to delete a service."
                    : "Unable to delete this service.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to delete this service: {ex.Message}";
        }
        finally
        {
            deletingServiceId = null;
        }
    }
}
